window-rule {
    match app-id="firefox"
    open-maximized true
}

window-rule {
    geometry-corner-radius 3
    clip-to-geometry true
}

// --- noctalia ---
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-"
    background-effect {
        blur false
    }
}
// --- end noct ---

input {
    disable-power-key-handling
    focus-follows-mouse max-scroll-amount="0%"

    keyboard {
        repeat-delay 300
        numlock
    }

    mouse {
        accel-profile "flat"
        // accel-speed 0.7 // -1.0 to 1.0, 0.0 default
    }
}

output "DP-3" {
    mode "2560x1440"
    scale 1
    position x=0 y=0

    focus-at-startup
}

output "DP-1" {
    mode "2560x1440"
    scale 1
    transform "270"
    position x=2560 y=-745

    hot-corners { off; }
}

binds {
    // ==== FOCUS ====
    // monitor
    Super+Shift+Semicolon { focus-monitor-left; }
    Super+Shift+Apostrophe { focus-monitor-right; }

    // workspace
    Super+Shift+Bracketleft { focus-workspace-up; }
    Super+Shift+Slash { focus-workspace-down; }
    Super+Shift+WheelScrollUp { focus-workspace-up; }
    Super+Shift+WheelScrollDown { focus-workspace-down; }

    // window
    Super+Semicolon { focus-column-left; }
    Super+Apostrophe { focus-column-right; }
    Super+Bracketleft { focus-window-up; }
    Super+Slash { focus-window-down; }
    Super+WheelScrollUp { focus-window-up-or-column-left; }
    Super+WheelScrollDown { focus-window-down-or-column-right; }

    // ==== APPS ====
    // launching
    Super+Shift+L { spawnsh "noctalia msg session lock"; }
    Super+Return { spawn "runapp" "kitty"; }
    Super+Space { spawn-sh "noctalia msg panel-open launcher"; }

    // moving + resizing
    Super+Period { switch-preset-column-width; }
    Super+F { maximize-column; }
    Super+Shift+F { fullscreen-window; }
    Super+J { consume-window-into-column; }

    // ==== NIRI ====
    Super+Shift+M { quit; }
    Super+Tab { toggle-overview; }
    Print { screenshot; }
    Super+Z { center-visible-columns; }
    Super+Q { close-window; }
    Super+P { spawn-sh "noctalia msg panel-open session"; }

    // special
    XF86AudioPlay { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause { spawn-sh "noctalia msg media pause"; }
    XF86AudioNext { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev { spawn-sh "noctalia msg media previous"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down 2"; }
    XF86AudioRaiseVolume { spawn-sh "noctalia msg vlume-up 2"; }
}

layout {
    always-center-single-column
    center-focused-column "on-overflow"
    gaps 6

    focus-ring { off; }
    border {
        width 2
        active-color "#5c845f"
        inactive-color "#b3b3b3"
        urgent-color "#c67b6c"
    }

    insert-hint {
        color "#d2c5a8"
    }

    default-column-width { proportion 0.66667; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}

spawn-at-startup "runapp" "udiskie" "--tray"
// spawn-at-startup "runapp" "wayland-pipewire-idle-inhibit" // TODO check if this is a problem on noctalia
spawn-at-startup "noctalia"
// TODO polkit

prefer-no-csd
screenshot-path "~/xdg/pictures/screenshot_%F_%T.png"

cursor {
    xcursor-theme "phinger-cursors-dark"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}
