[{
    "layer": "top",
    "output": "DP-3",
    "fixed-center": true,
    "position": "bottom",
    "margin-left": 5,
    "margin-bottom": 5,
    "margin-right": 5,
    "exclusive": true,
    "name": "bar1",

    "include": [
        "~/.config/waybar/shared.jsonc",
    ],

    "modules-left": [
        "niri/workspaces",
        "mpris"
    ],

    "modules-center": [
        "clock#1",
        "custom/at",
        "clock#2",
    ],

    "modules-right": [
        "tray",
        "custom/separator",
        "network",
        "custom/separator",
        "wireplumber",
        "custom/separator",
        "custom/mouseBat",
    ],
    
    "mpris": {
        "format": "<span color='#e67e80'>|</span> {artist} <span color='#e67e80'>~</span> {title}<span color='#a7c080'>@</span>{player}",
        "format-paused": "<span color='#e67e80'>|</span> {artist} <span color='#e67e80'>~</span> {title}<span color='#e67e80'>@</span>{player}",
        "max-length": 150,
        "ignored-players": ["firefox"],
    },

    "custom/at": {
        "format": " <span color='#a7c080'>@</span> "
    },

    "clock#1": {
        "format": "{:%A}",
        "tooltip-format": "{calendar}",
        "calendar": {
            "format": { "today": "<span color='#e67e80'><b>{}</b></span>" }
        },
    },

    "clock#2": {
        "format": "{:%R}",
        "tooltip-format": "{:%F}"
    },

    "tray": {
        "spacing": 10,
        "icon-size": 20,
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "wifi<span color='#a7c080'>@</span>{signalStrength}",
        "format-disconnected": "disconnected",
        "tooltip-format-wifi": "{essid}",
        "tooltip-format": "{bandwidthDownBytes}{bandwidthUpBytes}",
    },

    "wireplumber": {
        "format": "vol<span color='#a7c080'>@</span>{volume}",
        "format-muted": "vol<span color='#e67e80'>@</span>muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "niri msg action spawn -- runapp pavucontrol", 
        "scroll-step": 2,

    },

    "custom/mouseBat": {
        "format": "mouse<span color='#a7c080'>@</span>{} ",
        "interval": 1800,
        "exec": "cat /home/error/.scripts/outputs/mouseBat",
        "tooltip": false,
    },

    "custom/separator": {
        "format": " <span color='#e67e80'>|</span> ",
    },
}, {
    "layer": "top",
    "output": "DP-1",
    "position": "bottom",
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 5,
    "exclusive": true,
    "name": "bar2",

    "include": [
        "~/.config/waybar/shared.jsonc",
    ],

    "modules-left": [
        "clock#1"
    ],

    "modules-center": [
        "niri/workspaces"
    ],

    "clock#1": {
        "format": "   {:%R}",
    },
}]
